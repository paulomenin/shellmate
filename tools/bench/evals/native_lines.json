{
  "about": "How the arguments of a native tool call become the one-line text call. Rust (crates/shellmate-builtin/tests/native_lines.rs) and the evaluator (native.py) both read this file, so they cannot drift apart. `line` is what follows the tool's name; `error: true` is arguments the tool refuses to read.",
  "cases": [
    {"tool": "man", "arguments": {"page": "tar"}, "line": "tar"},
    {"tool": "man", "arguments": {"page": "quokka.conf", "section": "5"}, "line": "5 quokka.conf"},
    {"tool": "man", "arguments": {"page": "tar", "section": null}, "line": "tar"},
    {"tool": "man", "arguments": {"page": "-P cat"}, "line": "-P cat"},
    {"tool": "man", "arguments": {}, "error": true},
    {"tool": "man", "arguments": {"section": "5"}, "error": true},
    {"tool": "man", "arguments": {"page": 3}, "error": true},
    {"tool": "man", "arguments": {"page": "tar", "section": 5}, "error": true},
    {"tool": "man", "arguments": {"page": "tar", "extra": 1}, "error": true},
    {"tool": "man", "arguments": ["tar"], "error": true},
    {"tool": "man", "arguments": "tar", "error": true},
    {"tool": "man", "arguments": null, "error": true},
    {"tool": "help", "arguments": {"program": "git"}, "line": "git"},
    {"tool": "help", "arguments": {"program": "git", "subcommand": ["remote", "add"]}, "line": "git remote add"},
    {"tool": "help", "arguments": {"program": "git", "subcommand": []}, "line": "git"},
    {"tool": "help", "arguments": {"program": "git", "subcommand": ["--version"]}, "line": "git --version"},
    {"tool": "help", "arguments": {}, "error": true},
    {"tool": "help", "arguments": {"program": ["git"]}, "error": true},
    {"tool": "help", "arguments": {"program": "git", "subcommand": "x"}, "error": true},
    {"tool": "help", "arguments": {"program": "git", "subcommand": [1]}, "error": true},
    {"tool": "help", "arguments": {"program": "git", "subcommand": null}, "error": true},
    {"tool": "help", "arguments": {"program": "git", "options": ["-h"]}, "error": true},
    {"tool": "exec", "arguments": {"command": "git status"}, "line": "git status"},
    {"tool": "exec", "arguments": {"command": "ls | wc -l"}, "line": "ls | wc -l"},
    {"tool": "exec", "arguments": {}, "error": true},
    {"tool": "exec", "arguments": {"command": ["ls"]}, "error": true},
    {"tool": "exec", "arguments": {"command": "ls", "cwd": "/"}, "error": true},
    {"tool": "exec", "arguments": 3, "error": true},
    {"tool": "read", "arguments": {"path": "src/main.rs"}, "line": "src/main.rs"},
    {"tool": "read", "arguments": {}, "error": true},
    {"tool": "read", "arguments": {"path": 1}, "error": true},
    {"tool": "read", "arguments": {"path": "a", "mode": "w"}, "error": true},
    {"tool": "read", "arguments": ["a"], "error": true}
  ]
}
