# shellmate shell integration for fish (generated by `shellmate init fish`; do not edit).
# glue protocol v1, see docs/glue.md.
status is-interactive; or return

set -g __shellmate_bin '@BIN@'
# a fresh conversation session per interactive shell (docs/conversation.md section 2); exported for `shellmate conversation`
set -gx SHELLMATE_SESSION '@SESSION@'
set -g __shellmate_runtime (set -q XDG_RUNTIME_DIR; and echo $XDG_RUNTIME_DIR; or echo /tmp)/shellmate
command mkdir -p -m 700 $__shellmate_runtime 2>/dev/null
set -g __shellmate_status 0
set -g __shellmate_last ''
set -g __shellmate_dur 0
set -g __shellmate_hist
set -g __shellmate_hist_len 10

function __shellmate_cleanup --on-event fish_exit
    command rm -f "$__shellmate_runtime/$fish_pid.in" "$__shellmate_runtime/$fish_pid.out"
end

function __shellmate_postexec --on-event fish_postexec
    set -l st $status
    set -g __shellmate_status $st
    set -g __shellmate_last $argv[1]
    set -g __shellmate_dur $CMD_DURATION
    # bounded in-memory ring of "<status>\t<command>" (docs/glue.md section 4); the binary decides what is forwarded
    set -g __shellmate_hist $__shellmate_hist "$st"\t"$argv[1]"
    while test (count $__shellmate_hist) -gt $__shellmate_hist_len
        set -e __shellmate_hist[1]
    end
end

function __shellmate_widget --argument-names action
    set -l line (commandline --line)
    # move below the whole command line and clear (same pattern as fish's __fish_echo; docs/spike-fish.md)
    string >&2 repeat -N \n --count=(math (commandline | count) - $line + 1)
    echo -n \e\[J >&2
    # Envelope in, result out: both through files in the private runtime dir, and the binary is a plain
    # single-process job. A pipeline (`printf | bin`) would fork the builtin, and that fork would die on Ctrl-C,
    # making fish abort the whole widget; a command substitution is cancelled the same way. Also 1 fork per call.
    set -l inf "$__shellmate_runtime/$fish_pid.in"
    set -l result "$__shellmate_runtime/$fish_pid.out"
    printf 'v=1\0action=%s\0shell=fish\0shell_version=%s\0cwd=%s\0cursor=%s\0status=%s\0last_command=%s\0duration_ms=%s\0session=%s\0' \
        $action $version $PWD (commandline -C) $__shellmate_status "$__shellmate_last" $__shellmate_dur $SHELLMATE_SESSION >$inf
    if set -q __shellmate_hist[1]
        printf 'hist=%s\0' $__shellmate_hist >>$inf
    end
    printf 'buffer=%s\0' (commandline | string collect) >>$inf
    $__shellmate_bin invoke <$inf >$result
    set -l rc $status
    printf '' >$inf
    set -l out
    if test $rc -eq 0
        set out (string collect <$result)
        commandline -r -- $out
        commandline -C (string length -- $out)
    end
    string >&2 repeat -N \n --count=(math (count (fish_prompt)) - 1)
    string >&2 repeat -N \n --count=(math $line - 1)
    commandline -f repaint
end

@BINDINGS@
