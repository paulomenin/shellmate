# shellmate shell integration for zsh (generated by `shellmate init zsh`; do not edit).
# glue protocol v1, see docs/glue.md and docs/spike-zsh.md.
[[ -o interactive ]] || return 0
zmodload zsh/datetime 2>/dev/null

typeset -g __shellmate_bin='@BIN@'
# a fresh conversation session per interactive shell (docs/conversation.md section 2); exported for `shellmate conversation`
export SHELLMATE_SESSION='@SESSION@'
typeset -g __shellmate_runtime=${XDG_RUNTIME_DIR:-/tmp}/shellmate
[[ -d $__shellmate_runtime ]] || command mkdir -p -m 700 $__shellmate_runtime 2>/dev/null
typeset -g __shellmate_status=0 __shellmate_last='' __shellmate_cmd='' __shellmate_t0=''
typeset -gi __shellmate_dur=0
typeset -ga __shellmate_hist
typeset -gi __shellmate_hist_len=10

__shellmate_preexec() {
  __shellmate_cmd=$1
  __shellmate_t0=$EPOCHREALTIME
}

# must run first among the precmd hooks so that $? is still the user's command status
__shellmate_precmd() {
  local st=$?
  [[ -n $__shellmate_t0 ]] || return 0   # no command ran since the last prompt (first prompt, empty line)
  __shellmate_status=$st
  __shellmate_last=$__shellmate_cmd
  (( __shellmate_dur = (EPOCHREALTIME - __shellmate_t0) * 1000 ))   # integer variable: the float is truncated
  __shellmate_hist+=("$st"$'\t'"$__shellmate_cmd")
  (( ${#__shellmate_hist} > __shellmate_hist_len )) && __shellmate_hist=("${(@)__shellmate_hist[-__shellmate_hist_len,-1]}")
  __shellmate_t0=''
  return 0
}
preexec_functions+=(__shellmate_preexec)
precmd_functions=(__shellmate_precmd $precmd_functions)

__shellmate_run() {
  local action=$1 h out rc
  local inf=$__shellmate_runtime/$$.in result=$__shellmate_runtime/$$.out
  zle -I
  # Envelope in, result out, both through files: the binary is a plain single-process job (1 fork per call,
  # Ctrl-C reaches only the binary). docs/glue.md section 2.
  {
    printf 'v=1\0action=%s\0shell=zsh\0shell_version=%s\0cwd=%s\0cursor=%s\0status=%s\0last_command=%s\0duration_ms=%s\0session=%s\0' \
      $action $ZSH_VERSION $PWD $CURSOR $__shellmate_status $__shellmate_last $__shellmate_dur $SHELLMATE_SESSION
    for h in $__shellmate_hist; do printf 'hist=%s\0' $h; done
    printf 'buffer=%s\0' $BUFFER
  } >$inf
  $__shellmate_bin invoke <$inf >$result
  rc=$?
  : >$inf
  if (( rc == 0 )); then
    IFS= read -r -d '' out <$result
    BUFFER=$out
    CURSOR=${#BUFFER}
  fi
  zle -R   # not `reset-prompt`: it redraws one prompt-height too high and swallows the output (docs/spike-zsh.md)
}

@BINDINGS@
