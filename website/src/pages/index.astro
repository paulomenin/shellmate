---
// The landing page. Documentation lives under /docs (src/content/docs/docs/).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path: string) => `${base}/docs/${path}`;
const title = 'shellmate: a companion for your shell';
const description =
	'Type a question, press a key, get an answer or a command in your prompt. Never run for you. Works in fish, zsh and bash with local or remote models.';

const features = [
	{
		title: 'Three actions',
		text: 'ask answers a question, generate returns just one command, nothing else, explain explains one. Each has its own shortcut.',
	},
	{
		title: 'Never runs anything for you',
		text: 'A suggested command lands in your input line. You read it and press Enter. An Enter pressed while it was thinking is ignored.',
	},
	{
		title: 'Privacy first',
		text: 'Context is sent in levels. Secrets become placeholders on the way out and are restored on the way back. Remote providers are refused without redaction.',
	},
	{
		title: 'Your model, your choice',
		text: 'Ollama, LM Studio, OpenRouter, OpenAI or any OpenAI-compatible endpoint, with fallbacks when one is down.',
	},
	{
		title: 'Fish, zsh and bash',
		text: 'Thin shell glue tested in real shells, with and without starship. One Rust binary that starts in about 8 ms.',
	},
	{
		title: 'Follow-ups that remember',
		text: 'Press the shortcut again and the model remembers this shell\'s earlier turns. Nothing is written to disk.',
	},
];
import lightLogo from '../assets/logo-header.svg';
import darkLogo from '../assets/logo-header-dark.svg';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
	</head>
	<body>
		<header class="top">
			<a class="brand" href={`${base}/`} aria-label="shellmate">
					<picture>
						<source srcset={darkLogo.src} media="(prefers-color-scheme: dark)" />
						<img src={lightLogo.src} alt="shellmate" height="36" />
					</picture>
				</a>
			<nav>
				<a href={docs('')}>Docs</a>
				<a href={docs('start/install/')}>Install</a>
				<a href="https://github.com/paulomenin/shellmate" target="_blank" rel="noopener noreferrer">GitHub</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<h1>A companion for your shell.</h1>
				<p class="lead">
					Type a question, press a key, get an answer or a command <strong>in your prompt</strong>. Never run for you.
				</p>
				<p class="cta">
					<a class="button primary" href={docs('start/install/')}>Get started</a>
					<a class="button" href={docs('')}>Read the docs</a>
				</p>

				<pre class="term" aria-label="Example session"><code><span class="dim">$</span> how do I find the biggest files here?   <span class="key">alt+m</span>
Use du, sorted by size:
<span class="dim">↳ suggested:</span> du -sh * | sort -rh | head

<span class="dim">$</span> du -sh * | sort -rh | head<span class="cursor">█</span>   <span class="dim"># in your input line, for you to review</span></code></pre>
			</section>

			<section class="features" aria-label="Features">
				{features.map((f) => (
					<article>
						<h2>{f.title}</h2>
						<p>{f.text}</p>
					</article>
				))}
			</section>

			<section class="install">
				<h2>Install in two commands</h2>
				<pre><code>cargo build --release
target/release/shellmate setup</code></pre>
				<p>
					<code>setup</code> detects your shell and a local Ollama, writes a documented config, adds one marked block to your
					rc file and runs <code>doctor</code>. Early development: <a href={docs('concepts/roadmap/')}>see what works today</a>.
				</p>
			</section>
		</main>

		<footer>
			<span>MIT licensed.</span>
			<a href="https://github.com/paulomenin/shellmate" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
			<a href={docs('concepts/security-model/')}>Security model</a>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark light;
		--bg: #0e1620;
		--fg: #e6edf3;
		--dim: #8b9bab;
		--card: #15212e;
		--line: #243447;
		--accent: #1a7fc4;
		--accent-fg: #a8d6f5;
		--term-bg: #0a1018;
	}
	@media (prefers-color-scheme: light) {
		:root {
			--bg: #f7fafc;
			--fg: #14202b;
			--dim: #5a6b7b;
			--card: #ffffff;
			--line: #d5dee7;
			--accent: #1569a3;
			--accent-fg: #0d3f63;
			--term-bg: #101a24;
		}
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
	}
	a {
		color: var(--accent-fg);
	}
	.top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		max-width: 68rem;
		margin: 0 auto;
		padding: 1rem 1.25rem;
	}
	.brand {
		display: inline-flex;
	}
	.brand img {
		height: 2.25rem;
		width: auto;
	}
	.top nav {
		display: flex;
		gap: 1.25rem;
	}
	.top nav a {
		color: var(--dim);
		text-decoration: none;
	}
	.top nav a:hover {
		color: var(--fg);
	}
	main {
		max-width: 68rem;
		margin: 0 auto;
		padding: 0 1.25rem 3rem;
	}
	.hero {
		padding: 3.5rem 0 2rem;
		text-align: center;
	}
	h1 {
		font-size: clamp(2.2rem, 6vw, 3.6rem);
		line-height: 1.1;
		margin: 0 0 1rem;
	}
	.lead {
		font-size: 1.25rem;
		color: var(--dim);
		max-width: 38rem;
		margin: 0 auto 1.75rem;
	}
	.lead strong {
		color: var(--fg);
	}
	.cta {
		display: flex;
		gap: 0.75rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 2.5rem;
	}
	.button {
		display: inline-block;
		padding: 0.6rem 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		text-decoration: none;
		color: var(--fg);
		font-weight: 600;
	}
	.button.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
	.term,
	.install pre {
		background: var(--term-bg);
		color: #dce6ee;
		border: 1px solid var(--line);
		border-radius: 0.6rem;
		padding: 1.1rem 1.25rem;
		overflow-x: auto;
		font: 0.92rem/1.55 ui-monospace, SFMono-Regular, Menlo, monospace;
	}
	.term {
		max-width: 46rem;
		margin: 0 auto;
		text-align: left;
	}
	.term .dim {
		color: #7f93a6;
	}
	.term .key {
		float: right;
		margin-left: 1rem;
		padding: 0 0.45rem;
		border: 1px solid #3a5169;
		border-radius: 0.3rem;
		color: #a8d6f5;
		font-size: 0.8rem;
	}
	.term .cursor {
		animation: blink 1.1s steps(2, start) infinite;
	}
	@keyframes blink {
		to {
			visibility: hidden;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.term .cursor {
			animation: none;
		}
	}
	.features {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: 1rem;
		margin: 2rem 0 3rem;
	}
	.features article {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 0.6rem;
		padding: 1.1rem 1.25rem;
	}
	.features h2 {
		font-size: 1.05rem;
		margin: 0 0 0.35rem;
	}
	.features p {
		margin: 0;
		color: var(--dim);
	}
	.install {
		max-width: 46rem;
		margin: 0 auto;
	}
	.install h2 {
		margin-top: 0;
	}
	.install code:not(pre code) {
		background: var(--card);
		border: 1px solid var(--line);
		padding: 0.05rem 0.35rem;
		border-radius: 0.25rem;
	}
	footer {
		display: flex;
		gap: 1.5rem;
		justify-content: center;
		flex-wrap: wrap;
		padding: 1.5rem;
		border-top: 1px solid var(--line);
		color: var(--dim);
		font-size: 0.9rem;
	}
	footer a {
		color: var(--dim);
	}
</style>
